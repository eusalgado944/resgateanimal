{
  "name": "focinho-amigo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/config.js && node --check src/db.js && node --check scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
