# Copie para .env e ajuste os valores.
# Use apenas letras e números nas senhas (elas entram na URL de conexão do banco).

POSTGRES_DB=resgate
POSTGRES_USER=resgate
POSTGRES_PASSWORD=troque-esta-senha

# Usado só no desenvolvimento local (Postgres instalado na máquina). No docker-compose.yml
# a URL é montada automaticamente apontando para o serviço "db".
DATABASE_URL=postgres://resgate:troque-esta-senha@localhost:5432/resgate

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Administrador criado automaticamente na primeira inicialização
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ong.org
ADMIN_PASSWORD=troque-esta-senha-tambem

# Porta exposta pelo Nginx no host
WEB_PORT=80
